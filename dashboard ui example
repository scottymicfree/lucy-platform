        // Preferred production path: proxy this through your local Lucy backend so OAuth tokens never ship to the browser.
        const browserToken = import.meta.env?.VITE_OPENSKY_BEARER_TOKEN;
        if (browserToken) headers.Authorization = `Bearer ${browserToken}`;

