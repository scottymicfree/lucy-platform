    sunLightRef.current?.position.set(Math.cos(sunAngle) * 180, 35, Math.sin(sunAngle) * 180);
    rimLightRef.current?.position.set(Math.cos(sunAngle + Math.PI) * 120, -20, Math.sin(sunAngle + Math.PI) * 120);

