      size: event.size || 1.4,
      timestamp: event.timestamp || new Date()
    };
    updateHeat(normalized);
    setFeed((prev) => {
      const withoutDuplicate = prev.filter((item) => item.id !== normalized.id);
      return [normalized, ...withoutDuplicate].slice(0, MAX_FEED_ITEMS);
