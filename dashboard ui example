    [35.77, 140.39, 'NRT']
  ] as const;

  return Array.from({ length: 120 }).map((_, i) => {
    const hub = hubs[i % hubs.length];
    const lat = hub[0] + (Math.random() - 0.5) * 24;
    const lng = hub[1] + (Math.random() - 0.5) * 32;
    const heading = Math.random() * 360;
    const headingRad = heading * (Math.PI / 180);
    const dist = 0.9 + Math.random() * 2.7;
    const altitude = 2500 + Math.random() * 10000;
    return {
      id: `MOCK_${hub[2]}_${i}`,
      source: 'MOCK_ADSB',
      startLat: lat,
      startLng: lng,
      endLat: lat + Math.cos(headingRad) * dist,
      endLng: lng + Math.sin(headingRad) * dist,
      altitude,
      heading,
      velocity: 140 + Math.random() * 180,
      verticalRate: -8 + Math.random() * 16,
      country: 'Fallback',
      strokeThickness: clamp((altitude / 11000) * 0.75, 0.18, 0.75),
      color: flightColor(altitude, 'MOCK_ADSB')
    } as FlightArc;
  });
};

const loadImage = (src: string) =>
  new Promise<HTMLImageElement>((resolve, reject) => {
    const img = new Image();
    img.crossOrigin = 'anonymous';
    img.onload = () => resolve(img);
    img.onerror = reject;
    img.src = src;
  });

const buildRainviewerTexture = async (frame: { host: string; path: string }) => {
  const z = RAINVIEWER_TILE_ZOOM;
  const tileSize = RAINVIEWER_TILE_SIZE;
  const tiles = 2 ** z;

  const mercatorCanvas = document.createElement('canvas');
  mercatorCanvas.width = tiles * tileSize;
  mercatorCanvas.height = tiles * tileSize;
  const mercatorCtx = mercatorCanvas.getContext('2d', { willReadFrequently: true });
  if (!mercatorCtx) throw new Error('Canvas unavailable');

  const tileJobs: Promise<void>[] = [];
  for (let x = 0; x < tiles; x += 1) {
    for (let y = 0; y < tiles; y += 1) {
      const tileUrl = `${frame.host}${frame.path}/${tileSize}/${z}/${x}/${y}/2/1_1.png`;
      tileJobs.push(
        loadImage(tileUrl)
          .then((img) => mercatorCtx.drawImage(img, x * tileSize, y * tileSize, tileSize, tileSize))
          .catch(() => undefined)
      );
    }
  }

  await Promise.all(tileJobs);

  const source = mercatorCtx.getImageData(0, 0, mercatorCanvas.width, mercatorCanvas.height);
  const outWidth = 2048;
  const outHeight = 1024;
  const outCanvas = document.createElement('canvas');
  outCanvas.width = outWidth;
  outCanvas.height = outHeight;
  const outCtx = outCanvas.getContext('2d', { willReadFrequently: true });
  if (!outCtx) throw new Error('Output canvas unavailable');

  const output = outCtx.createImageData(outWidth, outHeight);
  const n = 2 ** z;

  for (let y = 0; y < outHeight; y += 1) {
    const lat = 90 - (y / outHeight) * 180;
    const latRad = (lat * Math.PI) / 180;
    const mercY = ((1 - Math.log(Math.tan(latRad) + 1 / Math.cos(latRad)) / Math.PI) / 2) * n * tileSize;
    const srcY = clamp(Math.floor(mercY), 0, source.height - 1);

    for (let x = 0; x < outWidth; x += 1) {
      const lon = (x / outWidth) * 360 - 180;
      const mercX = ((lon + 180) / 360) * n * tileSize;
      const srcX = clamp(Math.floor(mercX), 0, source.width - 1);
      const srcIndex = (srcY * source.width + srcX) * 4;
      const dstIndex = (y * outWidth + x) * 4;

      output.data[dstIndex] = source.data[srcIndex];
      output.data[dstIndex + 1] = source.data[srcIndex + 1];
      output.data[dstIndex + 2] = source.data[srcIndex + 2];
      output.data[dstIndex + 3] = Math.floor(source.data[srcIndex + 3] * 0.72);
    }
  }

  outCtx.putImageData(output, 0, 0);
  const texture = new THREE.CanvasTexture(outCanvas);
  texture.colorSpace = THREE.SRGBColorSpace;
  texture.needsUpdate = true;
  return texture;
};

