              <span className="flex h-2 w-2 relative">
                <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-lucy-danger opacity-75" />
                <span className="relative inline-flex rounded-full h-2 w-2 bg-lucy-danger" />
              </span>
              <span className="text-[10px] font-mono text-slate-300 uppercase tracking-widest">Global viewport live</span>
            </div>

