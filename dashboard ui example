const signalColor = (confidence: number) => {
  if (confidence >= 0.85) return '#10b981';
  if (confidence >= 0.6) return '#06b6d4';
  if (confidence >= 0.35) return '#f59e0b';
  return '#94a3b8';
};

const trendColor = (trend?: string) => {
  if (trend === 'RISING') return 'border-red-400/40 bg-red-500/10 text-red-300';
  if (trend === 'FALLING') return 'border-emerald-400/40 bg-emerald-500/10 text-emerald-300';
