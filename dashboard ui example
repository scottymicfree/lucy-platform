              title={isExpanded ? 'Collapse View' : 'Enlarge Global Viewer'}
            >
              {isExpanded ? <Minimize2 className="w-4 h-4" /> : <Maximize2 className="w-4 h-4" />}
            </button>

            <div
              ref={containerRef}
              className={`relative overflow-hidden transition-all duration-500 rounded-lg flex items-center justify-center ${isExpanded ? 'w-full h-[680px]' : 'w-full h-[390px] bg-[#020610] border border-slate-800'}`}
