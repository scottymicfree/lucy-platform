        if (!res.ok) throw new Error(`RainViewer ${res.status}`);
        const maps = await res.json();
        const latest = maps?.radar?.past?.[maps.radar.past.length - 1];
        if (!latest?.path || !maps?.host) throw new Error('RainViewer frame unavailable');
        const texture = await buildRainviewerTexture({ host: maps.host, path: latest.path });
        if (!isActive) return;
        setWeatherFrame({
          host: maps.host,
          path: latest.path,
          time: latest.time,
          generated: maps.generated,
          texture,
          status: 'live',
          message: `RainViewer radar frame ${new Date(latest.time * 1000).toLocaleTimeString()}`
        });
        addFeedEvent({
          id: `weather_radar_${latest.time}`,
          source: 'WEATHER_RADAR',
          type: 'Global Radar Texture Updated',
          value: new Date(latest.time * 1000).toLocaleTimeString(),
          location: 'Global radar composite',
          timestamp: new Date(latest.time * 1000),
          urlRef: 'rainviewer.com',
          lat: 0,
          lng: 0,
          size: 1.8,
          color: SOURCE_VISUALS.WEATHER_RADAR.ring,
          agentSource: 'EarthFeed',
          intent: 'precipitation_overlay'
        } as SemanticEvent);
      } catch (err) {
        console.warn('[TwinEarth] Weather texture unavailable', err);
        if (isActive) {
          setWeatherFrame((prev) => ({ ...prev, status: 'error', message: 'Radar texture unavailable; cloud shell remains active.' }));
        }
      }
    };

    fetchEarthIntel();
    fetchFlights();
    fetchWeatherTexture();

    const intelInterval = window.setInterval(fetchEarthIntel, 60000);
    const flightInterval = window.setInterval(fetchFlights, 30000);
    const weatherInterval = window.setInterval(fetchWeatherTexture, 10 * 60 * 1000);

    return () => {
      isActive = false;
      window.clearInterval(intelInterval);
      window.clearInterval(flightInterval);
      window.clearInterval(weatherInterval);
      if (typeof possibleUnsubscribe === 'function') possibleUnsubscribe();
    };
  }, [addFeedEvent]);

  const runScenario = (e: React.FormEvent) => {
    e.preventDefault();
    if (!scenarioInput.trim() || isSimulating) return;

    setIsSimulating(true);
    setSimProgress(0);
    setMergeState((prev) => ({
      hypothesisA: 54,
      hypothesisB: 39,
      noise: 7,
      convergencePath: [
        ...prev.convergencePath.slice(-2),
        `Scenario queued: ${scenarioInput.slice(0, 42)}${scenarioInput.length > 42 ? '...' : ''}`,
