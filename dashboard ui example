};

const predictionPointFor = (prediction: PredictionPacket, idx: number): SemanticEvent => {
  const fallbackLocations = [
    { lat: 37.2, lng: -122.1 },
    { lat: 28.5, lng: -82.4 },
    { lat: 51.5, lng: -0.12 },
    { lat: 35.7, lng: 139.7 }
  ];
  const fallback = fallbackLocations[idx % fallbackLocations.length];
  const loc = prediction.location || fallback;
  const color = prediction.trend === 'RISING' ? '#ef4444' : prediction.trend === 'FALLING' ? '#10b981' : '#ec4899';

  return {
    id: `prediction_${prediction.domain}_${idx}_${Date.now()}`,
    source: 'LUCY_PREDICTION',
    type: `${prediction.domain.replaceAll('_', ' ')} Forecast`,
    value: `${Math.round(prediction.confidence * 100)}% confidence`,
    location: prediction.location ? 'Prediction Vector' : 'Synthetic Anchor',
    timestamp: new Date(),
    urlRef: 'LucyPredictionEngine',
    lat: loc.lat,
    lng: loc.lng,
    size: clamp(prediction.confidence * 4, 0.8, 4),
    color,
    agentSource: 'Lucy',
    intent: prediction.trend || 'STABLE'
  } as SemanticEvent;
};

const normalizeSolarWindSpeed = (payload: any): number | null => {
  const list = Array.isArray(payload) ? payload : payload?.data || payload?.wind || [];
  if (!Array.isArray(list) || list.length === 0) return null;

  const latest = [...list].reverse().find((row: any) => {
    const speed = row?.speed ?? row?.wind_speed ?? row?.bulk_speed ?? row?.[1] ?? row?.[2];
    return speed !== null && speed !== undefined && Number.isFinite(Number(speed));
  });

  if (!latest) return null;
  const speed = latest.speed ?? latest.wind_speed ?? latest.bulk_speed ?? latest[1] ?? latest[2];
  return Number(speed);
};

