                  arcEndLng="endLng"
                  arcColor={(d: any) => (d === hoverArc ? 'rgba(255,255,255,1)' : d.color)}
                  arcDashLength={(d: any) => (d.source === 'OPENSKY_LIVE' ? 0.42 : 0.25)}
                  arcDashGap={0.2}
                  arcDashInitialGap={() => Math.random()}
                  arcDashAnimateTime={(d: any) => (d.source === 'OPENSKY_LIVE' ? 1450 : 2600)}
                  arcAltitudeAutoScale={0.12}
                  arcStroke={(d: any) => d.strokeThickness || 0.35}
                  arcLabel={(d: FlightArc) => `
                    <div style="background: rgba(15, 23, 42, 0.93); border: 1px solid rgba(56, 189, 248, 0.35); padding: 8px; border-radius: 6px; font-family: monospace; font-size: 10px; color: white;">
                      <div style="font-weight: bold; color: ${d.source === 'OPENSKY_LIVE' ? '#38bdf8' : '#fbbf24'}; margin-bottom: 4px;">${d.source === 'OPENSKY_LIVE' ? 'LIVE' : 'MOCK'} Flight: ${d.id}</div>
                      <div>Country: ${d.country || 'N/A'}</div>
                      <div>Alt: ${Math.round(d.altitude || 0)}m</div>
                      <div>Hdg: ${Math.round(d.heading || 0)}°</div>
                      <div>Spd: ${Math.round((d.velocity || 0) * 3.6)} km/h</div>
                    </div>
                  `}
                  onArcHover={(arc: any) => setHoverArc(arc)}
                />
              )}
            </div>

            <div className="absolute bottom-4 left-4 right-4 flex justify-between gap-2 text-[9px] font-mono z-10 pointer-events-none">
              <div className="flex gap-2">
                <div className="bg-slate-900/85 border border-slate-700 px-2 py-1 rounded text-slate-400 flex items-center gap-1">
                  <Sun className="w-3 h-3 text-amber-300" /> SUN LIGHT <span className="text-lucy-success ml-1">REAL UTC</span>
                </div>
                <div className="bg-slate-900/85 border border-slate-700 px-2 py-1 rounded text-slate-400 flex items-center gap-1">
                  <CloudRain className="w-3 h-3 text-sky-300" /> {weatherFrame.message}
                </div>
              </div>
              <div className="flex gap-2 pointer-events-auto">
                {[
                  ['predictions', 'PREDICTIONS'],
                  ['weather', 'WEATHER'],
                  ['clouds', 'CLOUDS'],
                  ['flights', 'FLIGHTS'],
                  ['seismic', 'SEISMIC'],
                  ['labels', 'LABELS']
                ].map(([key, label]) => (
                  <button
                    key={key}
                    onClick={() => setLayers((l) => ({ ...l, [key]: !l[key as keyof LayerState] }))}
                    className={`px-2 py-1 rounded border ${layers[key as keyof LayerState] ? 'bg-lucy-primary/20 border-lucy-primary text-lucy-primary' : 'bg-slate-900 border-slate-700 text-slate-500'}`}
                  >
                    {label}
                  </button>
                ))}
              </div>
            </div>
          </div>

          <div className="bg-slate-900/60 border border-slate-800 rounded-md p-4 flex flex-col">
            <h3 className="text-xs tracking-widest text-slate-300 font-mono flex items-center gap-2 mb-3 border-b border-slate-800 pb-2">
              <Satellite className="w-3 h-3 text-blue-400" /> Live Source Bridge
            </h3>
            <div className="grid grid-cols-2 gap-x-4 gap-y-2 font-mono text-[9px] text-slate-400">
              <div className="flex justify-between items-center bg-slate-950 px-2 py-1.5 rounded"><span>Earthquakes:</span><span className="text-orange-300">USGS</span></div>
              <div className="flex justify-between items-center bg-slate-950 px-2 py-1.5 rounded"><span>Solar Wind:</span><span className="text-cyan-300">NOAA RTSW</span></div>
              <div className="flex justify-between items-center bg-slate-950 px-2 py-1.5 rounded"><span>Flights:</span><span className={flightMode === 'live' ? 'text-cyan-300' : 'text-amber-300'}>{flightStatusText}</span></div>
              <div className="flex justify-between items-center bg-slate-950 px-2 py-1.5 rounded"><span>Weather:</span><span className={weatherFrame.status === 'live' ? 'text-sky-300' : 'text-slate-400'}>{weatherStatusText}</span></div>
            </div>
          </div>
        </div>

        <div className="flex flex-col bg-slate-950 border border-slate-800 rounded-md overflow-hidden shadow-lg h-full">
          <div className="p-3 border-b border-slate-800 bg-slate-900 flex flex-col gap-3">
            <div className="flex justify-between items-center">
              <h3 className="text-xs uppercase tracking-widest text-slate-300 font-mono flex items-center gap-2">
                <Brain className="w-4 h-4 text-lucy-primary" /> Planetary Cognition Ingestion
              </h3>
              <span className="text-[9px] font-mono text-lucy-success animate-pulse px-2 py-0.5 border border-lucy-success/30 rounded-sm bg-lucy-success/10">THINKING</span>
            </div>

            <div className="bg-slate-950 border border-slate-800 p-3 rounded flex flex-col gap-3 font-mono">
              <div className="text-[10px] text-slate-400 font-bold mb-1 flex items-center gap-2">
                <Cpu className="w-3 h-3 text-purple-400" /> Lucy Internal Merge State
              </div>
              {[
                ['Hypothesis A', mergeState.hypothesisA, 'bg-purple-500'],
                ['Hypothesis B', mergeState.hypothesisB, 'bg-blue-500'],
                ['Noise', mergeState.noise, 'bg-slate-500']
              ].map(([label, value, color]) => (
                <div className="flex flex-col gap-1" key={String(label)}>
                  <div className="flex justify-between text-[9px] text-slate-300"><span>{label}</span><span>{value}%</span></div>
                  <div className="h-1.5 w-full bg-slate-900 rounded-full overflow-hidden"><div className={`h-full ${color} transition-all duration-500`} style={{ width: `${value}%` }} /></div>
                </div>
              ))}
              <div className="flex flex-col gap-1 mt-2 p-2 bg-slate-900 border border-slate-800 rounded">
                <span className="text-[9px] text-slate-400 font-bold mb-1">Convergence Path:</span>
                {mergeState.convergencePath.map((path, idx) => (
                  <div key={`${path}_${idx}`} className="text-[9px] text-slate-300 flex items-start gap-2"><span className="text-purple-400 opacity-60">→</span><span>{path}</span></div>
                ))}
              </div>
            </div>

            <PredictionStrip predictions={predictions} onPromotePrediction={promotePrediction} />
          </div>

          <div className="flex-1 overflow-y-auto p-2 custom-scrollbar space-y-1.5">
            <AnimatePresence>
              {feed.map((event) => {
                const visual = sourceVisual(event.source);
                return (
                  <motion.div
                    initial={{ opacity: 0, x: -20, height: 0 }}
                    animate={{ opacity: 1, x: 0, height: 'auto' }}
                    key={event.id}
                    className="bg-slate-900 border border-slate-800/80 p-2.5 rounded-[4px] text-[10px] font-mono flex flex-col gap-1.5 hover:border-lucy-primary/30 transition-colors"
                  >
                    <div className="flex justify-between items-center">
                      <span className={`font-bold px-1.5 py-0.5 rounded-[2px] text-[9px] border ${visual.badge}`}>{visual.glyph} {visual.label}</span>
                      <div className="flex items-center gap-1">
                        {event.agentSource && <span className="text-[8px] text-lucy-primary border border-lucy-primary/30 px-1 rounded">{event.agentSource}</span>}
                        <span className="text-slate-500 text-[8px]">{event.urlRef}</span>
                      </div>
                    </div>
                    <div className="flex items-center justify-between mt-1">
                      <span className="text-slate-300">{event.type}</span>
                      {event.intent && <span className="text-[8px] font-bold text-pink-300 opacity-90 uppercase">{event.intent}</span>}
                    </div>
                    <div className="flex justify-between text-slate-400 font-sans text-xs mt-0.5">
                      <span className="font-mono text-[9px] opacity-70 truncate pr-3">{event.location}</span>
                      <span className="text-white font-bold tracking-tight">{event.value}</span>
                    </div>
                  </motion.div>
                );
              })}
            </AnimatePresence>
          </div>
        </div>

        <div className="flex flex-col bg-slate-900 border border-lucy-primary/20 rounded-md relative overflow-hidden shadow-lg h-full">
          <div className="absolute top-0 right-0 w-48 h-48 bg-lucy-primary/10 rounded-full blur-[80px] pointer-events-none" />
          <div className="p-5 border-b border-slate-800 bg-slate-950/50">
            <h3 className="text-sm font-bold tracking-wide text-white flex items-center gap-2"><Play className="w-4 h-4 text-lucy-primary" /> Predictive Scenario Sandbox</h3>
            <p className="text-[10px] text-slate-400 mt-1 font-mono">Frontend sandbox progress only until wired to Lucy backend</p>
          </div>

          <form onSubmit={runScenario} className="p-5 flex-1 flex flex-col gap-5">
            <div className="flex flex-col gap-2">
              <label className="text-xs text-slate-400 font-mono">Location Target</label>
              <input
                type="text"
                placeholder="e.g. Gulf Coast, Los Angeles Basin, 34.05,-118.24"
                className="bg-slate-950 border border-slate-700/80 rounded px-4 py-2.5 text-xs text-slate-200 outline-none focus:border-lucy-primary font-mono transition-colors"
                disabled={isSimulating}
              />
            </div>

            <div className="flex flex-col gap-2">
              <label className="text-xs text-slate-400 font-mono">Physical Modification Prompt</label>
              <textarea
                value={scenarioInput}
                onChange={(e) => setScenarioInput(e.target.value)}
                className="bg-slate-950 border border-slate-700/80 rounded px-4 py-2.5 text-xs text-slate-200 outline-none focus:border-lucy-primary font-mono min-h-[120px] custom-scrollbar transition-colors leading-relaxed"
                placeholder="e.g. Inject heavy rainfall over Gulf Coast. Compare live radar, flight congestion, seismic stability, and NOAA solar-wind interference."
                disabled={isSimulating}
              />
            </div>

            <button
              type="submit"
              disabled={isSimulating || !scenarioInput.trim()}
              className="mt-2 bg-lucy-primary/10 border border-lucy-primary/30 text-lucy-primary hover:bg-lucy-primary/20 hover:border-lucy-primary/60 px-4 py-3 flex items-center justify-center gap-3 rounded text-xs tracking-widest uppercase font-bold font-mono transition-all disabled:opacity-50 disabled:cursor-not-allowed shadow-[0_0_15px_rgba(6,182,212,0.1)]"
            >
              {isSimulating ? <><span className="animate-spin w-4 h-4 border-2 border-lucy-primary border-t-transparent rounded-full" /> COMPUTING SANDBOX...</> : <><Play className="w-4 h-4" /> INJECT INTO TWIN EARTH</>}
            </button>

            {isSimulating && (
              <div className="mt-4 flex flex-col gap-2">
                <div className="flex justify-between text-[10px] font-mono text-slate-400"><span>Sandbox Render Stream</span><span>{Math.floor(simProgress)}%</span></div>
                <div className="h-1.5 w-full bg-slate-800 rounded-full overflow-hidden"><div className="h-full bg-lucy-primary shadow-[0_0_10px_#06b6d4] transition-all duration-300 ease-out" style={{ width: `${Math.min(simProgress, 100)}%` }} /></div>
              </div>
            )}

            {simProgress >= 100 && !isSimulating && (
              <motion.div initial={{ opacity: 0, y: 10, scale: 0.95 }} animate={{ opacity: 1, y: 0, scale: 1 }} className="bg-slate-900 border border-lucy-success/30 p-4 rounded mt-4 relative overflow-hidden">
                <div className="absolute top-0 left-0 w-1 h-full bg-lucy-success shadow-[0_0_10px_#10b981]" />
                <div className="flex gap-2 items-center text-lucy-success text-xs font-mono mb-2 font-bold px-2"><Activity className="w-4 h-4" /> Sandbox Candidate Ready</div>
                <p className="text-[10px] text-slate-300 font-mono leading-relaxed px-2">
                  Scenario path completed in UI sandbox. Next upgrade should send this request to Lucy backend, write the proposal to DeltaVault, then let Emma approve or reject execution.
                </p>
              </motion.div>
            )}

            <div className="mt-auto grid grid-cols-2 gap-2 text-[9px] font-mono text-slate-400">
              <div className="bg-slate-950 border border-slate-800 rounded p-2 flex items-center gap-2"><RadioTower className="w-3 h-3 text-cyan-300" /> Feed: {feed.length}</div>
              <div className="bg-slate-950 border border-slate-800 rounded p-2 flex items-center gap-2"><Plane className="w-3 h-3 text-sky-300" /> Flights: {flights.length}</div>
              <div className="bg-slate-950 border border-slate-800 rounded p-2 flex items-center gap-2"><CloudRain className="w-3 h-3 text-blue-300" /> Radar: {weatherFrame.status}</div>
              <div className="bg-slate-950 border border-slate-800 rounded p-2 flex items-center gap-2"><Layers className="w-3 h-3 text-pink-300" /> Hotspots: {hotspots.length}</div>
            </div>
          </form>
        </div>
      </div>
    </div>
  );
};

export default TwinEarthDashboard;
