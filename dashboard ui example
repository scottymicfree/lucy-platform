const flightColor = (altitude: number, source: FlightArc['source']) => {
  if (source === 'MOCK_ADSB') return 'rgba(148, 163, 184, 0.38)';
  if (altitude >= 10000) return 'rgba(56, 189, 248, 0.86)';
  if (altitude >= 5000) return 'rgba(34, 211, 238, 0.72)';
  return 'rgba(125, 211, 252, 0.58)';
};

const parseOpenSkyFlights = (data: any): FlightArc[] => {
  if (!Array.isArray(data?.states)) return [];

  return data.states
    .slice(0, MAX_FLIGHTS)
    .map((s: any[]) => {
      const lon = Number(s?.[5]);
      const lat = Number(s?.[6]);
      const heading = Number(s?.[10]);
      if (!Number.isFinite(lat) || !Number.isFinite(lon) || !Number.isFinite(heading)) return null;

      const altitude = Number(s?.[7] ?? s?.[13] ?? 0);
      const velocity = Number(s?.[9] ?? 0);
      const verticalRate = Number(s?.[11] ?? 0);
      const callsign = typeof s?.[1] === 'string' && s[1].trim() ? s[1].trim() : String(s?.[0] || `FLT_${Math.random()}`);
      const headingRad = heading * (Math.PI / 180);
      const projectedDistance = clamp((velocity || 160) / 110, 0.7, 3.2);
      const endLat = lat + Math.cos(headingRad) * projectedDistance;
      const endLng = lon + Math.sin(headingRad) * projectedDistance;
      const thickness = clamp((altitude / 11000) * 0.9, 0.22, 1.0);

      return {
        id: callsign,
        source: 'OPENSKY_LIVE' as const,
        startLat: lat,
        startLng: lon,
        endLat,
        endLng,
        altitude: Number.isFinite(altitude) ? altitude : 0,
        heading,
        velocity: Number.isFinite(velocity) ? velocity : 0,
        verticalRate: Number.isFinite(verticalRate) ? verticalRate : 0,
        country: s?.[2],
        strokeThickness: thickness,
        color: flightColor(altitude, 'OPENSKY_LIVE')
      };
    })
    .filter(Boolean) as FlightArc[];
};

const buildMockFlights = (): FlightArc[] => {
  const hubs = [
    [40.64, -73.77, 'JFK'],
