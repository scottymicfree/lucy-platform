              timestamp: new Date(f.properties?.time || Date.now()),
              urlRef: 'usgs.gov',
              lat: coords[1],
              lng: coords[0],
              size: clamp(mag * 0.48, 0.7, 5.8),
              color: mag >= 4 ? '#ef4444' : mag >= 3 ? '#f97316' : '#f59e0b'
            } as SemanticEvent;

            if (mag > 2.5) rawDrift += (mag ** 2) / 100;
            const anomaly = detectAnomaly(quakeEvent);
            if (anomaly) {
              quakeEvent.agentSource = 'Lucy';
              quakeEvent.intent = anomaly.flag;
              speakLucy(`${LucyInterpret(quakeEvent)} This one feels significant.`);
            } else {
              quakeEvent.agentSource = 'Emma';
              quakeEvent.intent = 'tectonic_release';
            }

            addFeedEvent(quakeEvent);
            if (mag >= 2.7) {
              setPulses((old) => [
                ...old,
                {
                  id: `pulse_quake_${f.id}_${Date.now()}`,
                  lat: quakeEvent.lat || 0,
                  lng: quakeEvent.lng || 0,
                  maxRadius: clamp(mag * 1.8, 3, 12),
                  propagationSpeed: clamp(mag, 1.8, 5.5),
                  color: mag >= 4 ? 'rgba(239, 68, 68, 0.62)' : 'rgba(249, 115, 22, 0.50)'
                }
              ].slice(-MAX_PULSES));
            }
          });

          if (rawDrift > 0) {
            globalEventBus.publish({
              id: `E-${Date.now()}`,
              source: 'Earth.USGS',
              target: 'L_Swarm',
              type: 'event',
              payload: { drift: rawDrift, trigger: 'EARTH.SEISMIC' },
              confidence: 0.95,
              trace: ['USGS', 'LucyEarthDashboard'],
              timestamp: Date.now()
            });
          }
        }

        let windSpeed: number | null = null;
        try {
          const windRes = await fetch(NOAA_RTSW_WIND_URL, { cache: 'no-store' });
          if (windRes.ok) windSpeed = normalizeSolarWindSpeed(await windRes.json());
        } catch {
          const legacyRes = await fetch(NOAAA_LEGACY_RTSW_URL, { cache: 'no-store' });
          if (legacyRes.ok) windSpeed = normalizeSolarWindSpeed(await legacyRes.json());
        }

        if (windSpeed && isActive) {
          addFeedEvent({
            id: `noaa_wind_${Math.floor(Date.now() / 60000)}`,
