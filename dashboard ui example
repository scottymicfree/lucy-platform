          </p>
        </div>
        <div className="flex gap-3 font-mono text-[10px]">
          <div className={`flex items-center gap-2 bg-slate-900/50 border px-3 py-1.5 rounded-sm ${flightMode === 'live' ? 'border-cyan-500/30 text-cyan-300' : 'border-amber-500/30 text-amber-300'}`}>
            <Plane className="w-3 h-3" /> {flightStatusText}
          </div>
          <div className={`flex items-center gap-2 bg-slate-900/50 border px-3 py-1.5 rounded-sm ${weatherFrame.status === 'live' ? 'border-sky-500/30 text-sky-300' : 'border-slate-700 text-slate-400'}`}>
            <CloudRain className="w-3 h-3" /> {weatherStatusText}
          </div>
          <div className="flex items-center gap-2 bg-slate-900/50 border border-slate-800 px-3 py-1.5 rounded-sm text-slate-300">
            <Database className="w-3 h-3 text-lucy-success" /> DeltaVault Ready
